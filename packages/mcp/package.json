{
  "name": "@minera-gpu/mcp",
  "version": "0.1.0",
  "description": "A read-only MCP server for the Minera network: lets AI agents read the network, its rigs, the Burn Pool, settlements and claims.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "minera-mcp": "./src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "build": "node scripts/build-package.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@minera/shared": "1.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "rolldown": "1.2.13",
    "typescript": "7.0.2"
  }
}
