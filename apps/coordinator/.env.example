# Names and defaults only. Real values live in the deployment platform, never in the repository.

# Postgres connection string (required)
DATABASE_URL=
# testnet or mainnet; testnet when unset
NETWORK=
# Comma-separated RPC URLs, tried in order; the chain's public endpoints when unset.
# user:password@ in a URL is sent as HTTP basic auth, never in the URL.
RPC_URL=
# Key that publishes settlements; without it settlement runs in dry mode and never publishes
PUBLISHER_PRIVATE_KEY=
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=

# Port to listen on; 8080 when unset
PORT=
# Length of an epoch in seconds; 3600 when unset
EPOCH_SECONDS=
# Seconds between node heartbeats; 30 when unset
HEARTBEAT_SECONDS=
# Seconds between chain log reads once caught up; 5 when unset
INDEX_POLL_SECONDS=
# Seconds between Burn Pool reads; 15 when unset
POOL_REFRESH_SECONDS=
# Most blocks one log request covers; 5000 when unset. A refused request halves it, down to 10
INDEX_LOG_RANGE=
# Share of playground prompts sent to a second rig, from 0 to 1; 0.2 when unset
REDUNDANCY_RATE=
# Model and output limit of playground prompts
PLAYGROUND_MODEL=
PLAYGROUND_MAX_TOKENS=
# Reverse proxies in front of the service, so the client address is read from the right hop; 1 when unset
TRUST_PROXY_HOPS=

# Sentinel: speed floor in work units per second (40 when unset), and the key for network digests.
# Without a salt, a fresh one is drawn at every start.
SENTINEL_MIN_TOKENS_PER_SECOND=
SENTINEL_NETWORK_SALT=

# fatal, error, warn, info, debug, trace or silent; info when unset
LOG_LEVEL=
